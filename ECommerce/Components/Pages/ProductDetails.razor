@page "/product/{Id:int}"

@using ECommerce.Entities
@inject ECommerce.Services.IProductService ProductService
@inject NavigationManager Nav

<div>
    <!-- ================= HEADER ================= -->
    <header class="site-header">
        <div class="site-header-inner">
            <button class="site-hamburger" @onclick="ToggleMobileMenu" aria-label="Menu">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>

            <a href="/" class="site-logo">
                <img src="/images/comfy-wear-logo.jpeg" alt="COMFY WEAR" class="site-logo-img" />
            </a>

            <nav class="site-nav @(_mobileMenuOpen ? "site-nav-open" : "")">
                <a class="site-nav-link" href="/" @onclick="@(() => _mobileMenuOpen = false)">Home</a>
                <a class="site-nav-link" href="/items" @onclick="@(() => _mobileMenuOpen = false)">Shop</a>
            </nav>

            <div class="site-header-right">
                <AuthStatus />
            </div>
        </div>
    </header>

    @if (Loading)
    {
        <div class="pd-page pd-loading-wrap">
            <div class="pd-spinner"></div>
            <span>Loading product...</span>
        </div>
    }
    else
    {
        @if (Product == null)
        {
            <div class="pd-page pd-empty-wrap">
                <div class="pd-empty">
                    <div class="pd-empty-icon">
                        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M16 16s-1.5-2-4-2-4 2-4 2" />
                            <line x1="9" y1="9" x2="9.01" y2="9" stroke-width="2" />
                            <line x1="15" y1="9" x2="15.01" y2="9" stroke-width="2" />
                        </svg>
                    </div>
                    <h2 class="pd-empty-title">Product not found</h2>
                    <p class="pd-empty-sub">The product you're looking for doesn't exist or has been removed.</p>
                    <button class="pd-btn-chat" @onclick="GoBack">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                        Back to Shop
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="pd-page">
                <button class="pd-floating-back" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="19" y1="12" x2="5" y2="12" />
                        <polyline points="12 19 5 12 12 5" />
                    </svg>
                </button>
                <div class="pd-card">
                    <div class="pd-image-wrap">
                        <div class="pd-main-image" @onclick="OpenLightbox">
                            @if (HasMainImage)
                            {
                                <img src="@MainImageSrc" alt="@Product.Name" />
                            }
                            @if (!HasMainImage)
                            {
                                <div class="pd-img-placeholder">
                                    <svg viewBox="0 0 64 64" width="52" height="52" fill="none" stroke="currentColor" stroke-width="1.2">
                                        <rect x="8" y="8" width="48" height="48" rx="6" />
                                        <circle cx="22" cy="24" r="5" />
                                        <path d="M8 44l14-14 10 10 8-8 16 16" />
                                    </svg>
                                </div>
                            }
                            <span class="pd-store-badge">comfy wear</span>
                            @if (productImages.Count > 1)
                            {
                                <span class="pd-img-counter">@(selectedImageIndex + 1) / @productImages.Count</span>
                            }
                            <div class="pd-img-zoom">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                                    <line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" />
                                </svg>
                            </div>
                        </div>
                        @if (productImages.Count > 1)
                        {
                            <div class="pd-thumbs">
                                @for (int i = 0; i < productImages.Count; i++)
                                {
                                    <button type="button"
                                            class="pd-thumb @(selectedImageIndex == i ? "pd-thumb-active" : "")"
                                            @onclick="() => SelectImage(i)"
                                            @onclick:stopPropagation="true">
                                        <img src="@productImages[i].ImagePath" alt="" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="pd-info">
                        <h1 class="pd-name">@Product.Name</h1>
                        <div class="pd-code">Product Code: SKU-@Product.Id.ToString("D4")</div>
                        <div class="pd-price">
                            Rs. @EffectivePrice.ToString("N0")/-
                        </div>
                        <div class="pd-details">
                            <div class="pd-detail-row">
                                <span class="pd-detail-label">Available Sizes:</span>
                                <span class="pd-detail-value">@SizeDisplay</span>
                            </div>
                            <div class="pd-detail-row">
                                <span class="pd-detail-label">Available Colours:</span>
                                <span class="pd-detail-value">@ColourDisplay</span>
                            </div>
                        </div>
                        @if (HasDescription)
                        {
                            <div class="pd-features">
                                @foreach (var feat in DescriptionFeatures)
                                {
                                    <span class="pd-feature">@feat</span>
                                }
                            </div>
                        }
                        <div class="pd-actions">
                            <a href="https://www.instagram.com/comfywear____" target="_blank" rel="noopener noreferrer" class="pd-btn-chat">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                                </svg>
                                Chat on Instagram
                            </a>
                        </div>
                    </div>
                </div>
                @if (LightboxOpen && productImages.Count > 0)
                {
                    <div class="pd-lightbox" @onclick="CloseLightbox">
                        <button class="pd-lb-close" @onclick="CloseLightbox" @onclick:stopPropagation="true">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                        @if (productImages.Count > 1)
                        {
                            <button class="pd-lb-arrow pd-lb-prev" @onclick="PrevImage" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="15 18 9 12 15 6" />
                                </svg>
                            </button>
                        }
                        <img src="@productImages[selectedImageIndex].ImagePath" alt="@Product.Name" @onclick:stopPropagation="true" />
                        @if (productImages.Count > 1)
                        {
                            <button class="pd-lb-arrow pd-lb-next" @onclick="NextImage" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </button>
                        }
                        <span class="pd-lb-counter">@(selectedImageIndex + 1) / @productImages.Count</span>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private int selectedImageIndex = 0;
    private Product? Product;
    private bool Loading = true;
    private bool LightboxOpen = false;
    private bool _mobileMenuOpen = false;
    private List<ECommerce.ViewModel.ProductImages> productImages = new();

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        selectedImageIndex = 0;
        LightboxOpen = false;

        var all = await ProductService.GetAllAsync();
        Product = all.FirstOrDefault(p => p.Id == Id);
        productImages = await ProductService.GetByIdAsync(Id);

        Loading = false;
    }

    private bool HasMainImage => !string.IsNullOrWhiteSpace(Product?.ImagePath);
    private string MainImageSrc => Product?.ImagePath ?? "";
    private decimal EffectivePrice =>
        Product?.OfferPrice.HasValue == true && Product.OfferPrice.Value > 0
            ? Product.OfferPrice.Value
            : Product?.Price ?? 0;
    private string SizeDisplay => !string.IsNullOrWhiteSpace(Product?.Size) ? Product.Size : "—";
    private string ColourDisplay => !string.IsNullOrWhiteSpace(Product?.Color) ? Product.Color.Replace(",", " | ") : "—";
    private bool HasDescription => !string.IsNullOrWhiteSpace(Product?.Description);
    private List<string> DescriptionFeatures =>
        string.IsNullOrWhiteSpace(Product?.Description)
            ? new List<string>()
            : Product.Description.Split(new[] { '•', '-', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void SelectImage(int index)
    {
        if (index < 0 || index >= productImages.Count) return;
        selectedImageIndex = index;
    }

    private void OpenLightbox() => LightboxOpen = true;
    private void CloseLightbox() => LightboxOpen = false;

    private void PrevImage()
    {
        if (productImages.Count == 0) return;
        selectedImageIndex = (selectedImageIndex - 1 + productImages.Count) % productImages.Count;
    }

    private void NextImage()
    {
        if (productImages.Count == 0) return;
        selectedImageIndex = (selectedImageIndex + 1) % productImages.Count;
    }

    private void GoBack()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var from = query["from"];

        if (!string.IsNullOrWhiteSpace(from))
        {
            Nav.NavigateTo(from);
        }
        else
        {
            Nav.NavigateTo("/items");
        }
    }

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
}