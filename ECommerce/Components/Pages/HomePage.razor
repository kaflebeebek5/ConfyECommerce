@page "/"
@inject ECommerce.Services.IProductService ProductService
@inject NavigationManager Nav

<div class="cw-page">

    <!-- ==================== HEADER ==================== -->
    <header class="site-header">
        <div class="site-header-inner">
            <button class="site-hamburger" @onclick="ToggleMobileMenu" aria-label="Menu">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>

            <div class="site-header-left">
                <a href="/" class="site-logo">
                    <img src="/images/comfy-wear-logo.jpeg" alt="COMFY WEAR" class="site-logo-img" />
                </a>
                <a href="https://www.instagram.com/comfywear____?igsh=MTF0aXk3dWJlMHkwNA==" target="_blank" rel="noopener noreferrer" class="site-insta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </svg>
                </a>

                <nav class="site-nav @(_mobileMenuOpen ? "site-nav-open" : "")">
                    <a class="site-nav-link active" href="/" @onclick="@(() => _mobileMenuOpen = false)">Home</a>
                    <a class="site-nav-link" href="/items" @onclick="@(() => _mobileMenuOpen = false)">Shop</a>
                </nav>
            </div>

            <div class="site-header-right">
                <AuthStatus />
            </div>
        </div>
    </header>

    <!-- ==================== SPECIAL WINTER OFFER BANNER ==================== -->
    <div class="cw-winter-banner">
        <div class="cw-winter-banner-inner">
            <span class="cw-winter-badge">LIMITED TIME OFFER</span>
            <h2 class="cw-winter-title">SPECIAL WINTER OFFER</h2>
            <p class="cw-winter-offer">RS. 100 OFF</p>
            <p class="cw-winter-sub">On each pair when purchasing 2 or more pairs</p>
        </div>
    </div>

    <!-- ==================== TRUST STRIP ==================== -->
    <div class="cw-trust-strip">
        <div class="cw-trust-track">
            @foreach (var item in TrustItems)
            {
                <span class="cw-trust-item">
                    <svg class="cw-trust-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        @((MarkupString)item.SvgPath)
                    </svg>
                    @item.Label
                </span>
                <span class="cw-trust-sep">&#x2022;</span>
            }
        </div>
    </div>

    <!-- ==================== SHOP BY CATEGORY ==================== -->
    <section class="cw-section">
        <div class="cw-section-header">
            <span class="cw-eyebrow">Browse</span>
            <h2 class="cw-section-title">Shop by Category</h2>
            <div class="cw-rule"></div>
        </div>

        <div class="cw-category-grid">
            @foreach (var cat in ShopCategories)
            {
                <button type="button" class="cw-category-card" @onclick="@(() => Nav.NavigateTo("/items?cat=" + Uri.EscapeDataString(cat.Name)))">
                    <div class="cw-category-icon">
                        <svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5">
                            @((MarkupString)cat.IconPath)
                        </svg>
                    </div>
                    <span class="cw-category-name">@cat.Name</span>
                    <span class="cw-category-count">@cat.Count items</span>
                </button>
            }
        </div>
    </section>

    <!-- ==================== NEW ARRIVALS ==================== -->
    @if (NewArrivals.Any())
    {
        <section class="cw-section cw-section-alt">
            <div class="cw-section-header">
                <span class="cw-eyebrow">Just Landed</span>
                <h2 class="cw-section-title">New Arrivals</h2>
                <div class="cw-rule"></div>
            </div>

            <div class="cw-product-grid">
                @foreach (var p in NewArrivals)
                {
                    <div class="cw-product-card" @onclick="@(() => Nav.NavigateTo($"/product/{p.Id}"))">
                        <div class="cw-product-img">
                            @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@p.Name" />
                            }
                            else
                            {
                                <div class="cw-product-placeholder">
                                    <svg viewBox="0 0 64 64" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="8" y="8" width="48" height="48" rx="4" />
                                        <circle cx="22" cy="24" r="5" />
                                        <path d="M8 44l14-14 10 10 8-8 16 16" />
                                    </svg>
                                </div>
                            }
                            <span class="cw-product-tag cw-tag-new">New</span>
                        </div>
                        <div class="cw-product-body">
                            @if (!string.IsNullOrWhiteSpace(p.Brand))
                            {
                                <span class="cw-product-brand">@p.Brand</span>
                            }
                            <span class="cw-product-name">@p.Name</span>
                            <div class="cw-product-footer">
                                <span class="cw-product-price">Rs. @EffectivePrice(p).ToString("N0")</span>
                                @if (p.OfferPrice.HasValue && p.OfferPrice > 0 && p.OfferPrice < p.Price)
                                {
                                    <span class="cw-product-price-original">Rs. @p.Price.ToString("N0")</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="cw-section-cta">
                <button class="cw-btn cw-btn-primary" @onclick="@(() => Nav.NavigateTo("/items?cat=New Arrivals"))">
                    View All New Arrivals
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            </div>
        </section>
    }

    <!-- ==================== SPECIAL OFFERS ==================== -->
    @if (SpecialOffers.Any())
    {
        <section class="cw-section">
            <div class="cw-section-header">
                <span class="cw-eyebrow">Deals</span>
                <h2 class="cw-section-title">Special Offers</h2>
                <div class="cw-rule"></div>
            </div>

            <div class="cw-product-grid">
                @foreach (var p in SpecialOffers)
                {
                    <div class="cw-product-card" @onclick="@(() => Nav.NavigateTo($"/product/{p.Id}"))">
                        <div class="cw-product-img">
                            @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@p.Name" />
                            }
                            else
                            {
                                <div class="cw-product-placeholder">
                                    <svg viewBox="0 0 64 64" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="8" y="8" width="48" height="48" rx="4" />
                                        <circle cx="22" cy="24" r="5" />
                                        <path d="M8 44l14-14 10 10 8-8 16 16" />
                                    </svg>
                                </div>
                            }
                            <span class="cw-product-tag cw-tag-offer">Offer</span>
                        </div>
                        <div class="cw-product-body">
                            @if (!string.IsNullOrWhiteSpace(p.Brand))
                            {
                                <span class="cw-product-brand">@p.Brand</span>
                            }
                            <span class="cw-product-name">@p.Name</span>
                            <div class="cw-product-footer">
                                <span class="cw-product-price">Rs. @EffectivePrice(p).ToString("N0")</span>
                                @if (p.OfferPrice.HasValue && p.OfferPrice > 0 && p.OfferPrice < p.Price)
                                {
                                    <span class="cw-product-price-original">Rs. @p.Price.ToString("N0")</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="cw-section-cta">
                <button class="cw-btn cw-btn-primary" @onclick="@(() => Nav.NavigateTo("/items?cat=Special Offers"))">
                    View All Special Offers
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            </div>
        </section>
    }

    <!-- ==================== FOOTER ==================== -->
    <footer class="site-footer">
        <div class="site-footer-inner">
            <div class="site-footer-brand">
                <a href="/" class="site-logo">
                    <img src="/images/comfy-wear-logo.jpeg" alt="COMFY WEAR" class="site-logo-img" />
                </a>
                <p class="site-footer-desc">Handcrafted footwear for everyday adventures. Built to last, designed to impress.</p>
            </div>
            <div class="site-footer-col">
                <h4>Shop</h4>
                <a href="/items">All Products</a>
                @foreach (var cat in ShopCategories)
                {
                    <a href="/items?cat=@Uri.EscapeDataString(cat.Name)">@cat.Name</a>
                }
            </div>
            <div class="site-footer-col">
                <h4>Help</h4>
                <a href="#">Shipping Info</a>
                <a href="#">Returns</a>
                <a href="#">Contact Us</a>
            </div>
            <div class="site-footer-col">
                <h4>Follow Us</h4>
                <a href="https://www.instagram.com/comfywear____?igsh=MTF0aXk3dWJlMHkwNA==" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="https://www.instagram.com/comfywear____?igsh=MTF0aXk3dWJlMHkwNA==" target="_blank" rel="noopener noreferrer">Facebook</a>
                <a href="https://www.instagram.com/comfywear____?igsh=MTF0aXk3dWJlMHkwNA==" target="_blank" rel="noopener noreferrer">TikTok</a>
            </div>
        </div>
    </footer>

</div>

@code {
    private bool _mobileMenuOpen = false;
    private List<ECommerce.Entities.Product> NewArrivals = new();
    private List<ECommerce.Entities.Product> SpecialOffers = new();

    private record CategoryTile(string Name, string IconPath, int Count);
    private record TrustInfo(string SvgPath, string Label);

    private static readonly string[] CategoryNames =
    {
        "Flat Sandals", "Winter Collection", "Ethnic & Festive Wear",
        "Heels", "Special Offers", "New Arrivals"
    };

    private List<TrustInfo> TrustItems = new()
    {
        new("<path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/>", "Delivery all over Nepal"),
        new("<rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/>", "Cash on Delivery"),
        new("<path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/>", "Factory Direct"),
        new("<path d=\"M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/>", "Retail & Wholesale"),
    };

    private List<CategoryTile> ShopCategories = new();

    protected override async Task OnInitializedAsync()
    {
        var allProducts = await ProductService.GetAllAsync();

        ShopCategories = CategoryNames.Select(name => new CategoryTile(
            name,
            IconFor(name),
            CountFor(name, allProducts)
        )).ToList();

        NewArrivals = allProducts
            .Where(p => p.IsNewArrival && !p.IsSoldOut && p.StockQuantity > 0)
            .Take(8)
            .ToList();

        SpecialOffers = allProducts
            .Where(p => p.IsSpecialOffer && !p.IsSoldOut && p.StockQuantity > 0)
            .Take(8)
            .ToList();
    }

    private static int CountFor(string category, List<ECommerce.Entities.Product> products)
    {
        return category switch
        {
            "Special Offers" => products.Count(p => p.IsSpecialOffer),
            "New Arrivals" => products.Count(p => p.IsNewArrival),
            _ => products.Count(p => !string.IsNullOrWhiteSpace(p.Category)
                && p.Category.Equals(category, StringComparison.OrdinalIgnoreCase))
        };
    }

    private static string IconFor(string category) => category switch
    {
        "Flat Sandals" => "<path d=\"M6 32 Q6 20 18 18 L42 16 Q52 16 52 26 Q52 34 42 36 L14 38 Q6 38 6 32Z\"/><path d=\"M18 18 L22 10 M38 16 L36 8\"/><circle cx=\"22\" cy=\"10\" r=\"2\"/><circle cx=\"36\" cy=\"8\" r=\"2\"/>",
        "Winter Collection" => "<path d=\"M14 38 L14 14 Q14 8 20 8 L36 8 Q42 8 42 14 L42 38\"/><path d=\"M14 38 L8 38 L8 44 L46 44 L46 38 L42 38\"/><path d=\"M14 22 L42 22\"/>",
        "Ethnic & Festive Wear" => "<path d=\"M10 32 Q10 22 22 20 L42 19 Q50 19 50 27 Q50 34 42 35 L14 36 Q10 36 10 32Z\"/><path d=\"M24 20 Q26 12 32 10 M32 10 l4-4 M32 10 l-2-5\"/><circle cx=\"36\" cy=\"6\" r=\"2\"/>",
        "Heels" => "<path d=\"M14 28 Q14 18 24 16 L40 15 Q48 15 48 22 Q48 30 40 31 L18 33 Q14 33 14 28Z\"/><path d=\"M18 33 L16 44 L22 44 L22 33\"/><line x1=\"16\" y1=\"44\" x2=\"22\" y2=\"44\"/>",
        "Special Offers" => "<path d=\"M12 10 h24 v10 a5 5 0 0 1 0 10 v10 h-24 v-10 a5 5 0 0 1 0-10 z\"/><line x1=\"24\" y1=\"12\" x2=\"24\" y2=\"38\" stroke-dasharray=\"2 3\"/>",
        "New Arrivals" => "<path d=\"M10 32 Q10 22 22 20 L42 19 Q50 19 50 27 Q50 34 42 35 L14 36 Q10 36 10 32Z\"/><path d=\"M24 8 v10 M19 13 h10\"/>",
        _ => "<path d=\"M10 32 Q10 22 22 20 L42 19 Q50 19 50 27 Q50 34 42 35 L14 36 Q10 36 10 32Z\"/>"
    };

    private static decimal EffectivePrice(ECommerce.Entities.Product p) =>
        p.OfferPrice.HasValue && p.OfferPrice > 0 ? p.OfferPrice.Value : p.Price;

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }
}
