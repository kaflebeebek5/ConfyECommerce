@using ECommerce.Entities
@using ECommerce.ViewModel
@using ECommerce.Services
@inject IProductService ProductService
@inject IStyleService StyleService
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="pf-form">

    <div class="pf-header">
        <div class="pf-header-icon">
            @if (IsEdit)
            {
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
            }
        </div>
        <div>
            <h3 class="pf-header-title">@(IsEdit ? "Edit Product" : "New Product")</h3>
            <p class="pf-header-sub">@(IsEdit ? "Update product details below" : "Fill in the details to add a new product")</p>
        </div>
    </div>

    <div class="pf-divider"></div>

    <div class="pf-fields">
        <div class="pf-field">
            <label class="pf-label">Name <span class="pf-required">*</span></label>
            <input class="@("pf-input" + (ShowValidation && string.IsNullOrWhiteSpace(Model.Name) ? " pf-input-error" : ""))"
                   @bind="Model.Name" @bind:event="oninput" placeholder="e.g. Classic Leather Sandal" />
            @if (ShowValidation && string.IsNullOrWhiteSpace(Model.Name))
            {
                <span class="pf-field-error">Product name is required</span>
            }
        </div>

        <div class="pf-field">
            <label class="pf-label">Description</label>
            <textarea class="pf-input pf-textarea" @bind="Model.Description" rows="2"
                      placeholder="Short product description..."></textarea>
        </div>

        <div class="pf-row">
            <div class="pf-field">
                <label class="pf-label">Brand</label>
                <input class="pf-input" @bind="Model.Brand" placeholder="e.g. Klobyte" />
            </div>
            <div class="pf-field">
                <label class="pf-label">Style</label>
                <select class="pf-input pf-select" @bind="StyleIdStr">
                    <option value="">-- Select Style --</option>
                    @foreach (var s in Styles)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="pf-row">
            <div class="pf-field">
                <label class="pf-label">Price (Rs.) <span class="pf-required">*</span></label>
                <input type="number" min="0" step="1"
                       class="@("pf-input" + (ShowValidation && Model.Price <= 0 ? " pf-input-error" : ""))"
                       @bind="Model.Price" />
            </div>
            <div class="pf-field">
                <label class="pf-label">Offer Price (Rs.)</label>
                <input type="number" min="0" step="1"
                       class="pf-input"
                       @bind="Model.OfferPrice"
                       placeholder="e.g. 699" />
            </div>
        </div>

        <div class="pf-row">
            <div class="pf-field">
                <label class="pf-label">Stock Quantity <span class="pf-required">*</span></label>
                <input type="number" min="0" step="1"
                       class="@("pf-input" + (ShowValidation && Model.StockQuantity < 0 ? " pf-input-error" : ""))"
                       @bind="Model.StockQuantity" />
            </div>
            <div class="pf-field">
                <label class="pf-label">Category</label>
                <select class="pf-input pf-select" @bind="Model.Category">
                    <option value="">-- Select Category --</option>
                    <option value="Flat Sandals">Flat Sandals</option>
                    <option value="Winter Collection">Winter Collection</option>
                    <option value="Ethnic & Festive Wear">Ethnic & Festive Wear</option>
                    <option value="Heels">Heels</option>
                    <option value="Special Offers">Special Offers</option>
                    <option value="New Arrivals">New Arrivals</option>
                </select>
            </div>
        </div>

        <div class="pf-field">
            <label class="pf-label">Available Sizes</label>
            <div class="pf-option-grid">
                @foreach (var size in SizeOptions)
                {
                    <label class="@("pf-option-chip" + (IsSizeChecked(size) ? " pf-option-selected" : ""))">
                        <input type="checkbox" checked="@IsSizeChecked(size)" @onchange="@(() => ToggleSize(size))" />
                        <span>@size</span>
                    </label>
                }
            </div>
        </div>

        <div class="pf-field">
            <label class="pf-label">Available Colours</label>
            <div class="pf-option-grid">
                @foreach (var colour in ColourOptions)
                {
                    <label class="@("pf-option-chip" + (IsColourChecked(colour) ? " pf-option-selected" : ""))">
                        <input type="checkbox" checked="@IsColourChecked(colour)" @onchange="@(() => ToggleColour(colour))" />
                        <span>@colour</span>
                    </label>
                }
            </div>
        </div>

        <div class="pf-field">
            <label class="pf-label">Date Added</label>
            <input type="date" class="pf-input" @bind="Model.CreatedAt" />
        </div>

        <div class="pf-row pf-toggle-row">
            <div class="pf-field pf-toggle-field">
                <input type="checkbox" class="pf-checkbox" @bind="Model.IsNewArrival" />
                <label class="pf-checkbox-label">New Arrival</label>
            </div>
            <div class="pf-field pf-toggle-field">
                <input type="checkbox" class="pf-checkbox" @bind="Model.IsSpecialOffer" />
                <label class="pf-checkbox-label">Special Offer</label>
            </div>
            <div class="pf-field pf-toggle-field">
                <input type="checkbox" class="pf-checkbox" @bind="Model.IsSoldOut" />
                <label class="pf-checkbox-label">Sold Out</label>
            </div>
        </div>

        <!-- ==================== COVER IMAGE ==================== -->
        <div class="pf-cover-section">
            <div class="pf-section-header">
                <div class="pf-section-icon pf-section-icon-cover">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                    </svg>
                </div>
                <div>
                    <span class="pf-section-title">Cover Image <span class="pf-required">*</span></span>
                    <span class="pf-section-sub">Main product image shown in listings</span>
                </div>
            </div>

            <div class="pf-cover-upload-area">
                @if (GetCoverImages().Any())
                {
                    var cover = GetCoverImages().First();
                    <div class="pf-cover-preview">
                        <img src="@GetPreviewSrc(cover)" alt="Cover" />
                        <button type="button" class="pf-cover-remove" @onclick="@(() => RemoveCoverImage())">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                        <span class="pf-cover-badge">Cover</span>
                    </div>
                    <div class="pf-cover-change">
                        <InputFile OnChange="OnCoverSelected" accept="image/*" class="pf-file-input" id="pf-cover-input" style="display:none" />
                        <label for="pf-cover-input" class="pf-cover-change-btn">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                            </svg>
                            Change Cover
                        </label>
                    </div>
                }
                else
                {
                    <InputFile OnChange="OnCoverSelected" accept="image/*" class="pf-file-input" id="pf-cover-input-empty" style="display:none" />
                    <label for="pf-cover-input-empty" class="pf-cover-empty">
                        <div class="pf-cover-empty-icon">
                            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                <circle cx="8.5" cy="8.5" r="1.5" />
                                <polyline points="21 15 16 10 5 21" />
                            </svg>
                        </div>
                        <span class="pf-cover-empty-text">Click to upload cover image</span>
                        <span class="pf-cover-empty-hint">JPG, PNG up to 4MB</span>
                    </label>
                }
            </div>
        </div>

        <!-- ==================== COLOR VARIANTS ==================== -->
        <div class="pf-colors-section">
            <div class="pf-section-header">
                <div class="pf-section-icon pf-section-icon-color">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="13.5" cy="6.5" r="2.5" /><circle cx="17.5" cy="10.5" r="2.5" />
                        <circle cx="8.5" cy="7.5" r="2.5" /><circle cx="6.5" cy="12" r="2.5" />
                        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16c3.3 0 6-2.7 6-6 0-5.5-4.5-9-10-9z" />
                    </svg>
                </div>
                <div>
                    <span class="pf-section-title">Color Variants</span>
                    <span class="pf-section-sub">Upload images for each color option</span>
                </div>
            </div>

            @if (ColorGroups.Any())
            {
                @for (int gi = 0; gi < ColorGroups.Count; gi++)
                {
                    var groupIdx = gi;
                    var group = ColorGroups[groupIdx];
                    var colorImages = GetImagesForColor(group.ColorName);

                    <div class="pf-color-group">
                        <div class="pf-color-group-header">
                            <div class="pf-color-dot" style="background:@ColorToHex(group.ColorName)"></div>
                            <input class="pf-color-name-input" value="@group.ColorName"
                                   @oninput="@((e) => OnColorNameChanged(groupIdx, e))"
                                   placeholder="e.g. Tan, Black, Navy" />
                            <button type="button" class="pf-color-remove-btn" @onclick="@(() => RemoveColorGroup(groupIdx))">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                </svg>
                                Remove
                            </button>
                        </div>

                        <div class="pf-color-images-grid">
                            @for (int ii = 0; ii < colorImages.Count; ii++)
                            {
                                var imgIdx = ii;
                                var img = colorImages[imgIdx];
                                var isExisting = img.Id != 0;

                                <div class="@("pf-color-img-item" + (isExisting ? " pf-color-img-existing" : ""))">
                                    <img src="@GetPreviewSrc(img)" alt="@group.ColorName image" />
                                    <button type="button" class="pf-color-img-remove" @onclick="@(() => RemoveColorImage(group.ColorName, imgIdx))">
                                        <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </button>
                                    @if (isExisting)
                                    {
                                        <span class="pf-color-img-tag">Saved</span>
                                    }
                                </div>
                            }

                            <InputFile OnChange="@((e) => OnColorFilesSelected(groupIdx, e))"
                                       multiple accept="image/*"
                                       class="pf-file-input" id="@($"pf-color-input-{groupIdx}")" style="display:none" />
                            <label for="@($"pf-color-input-{groupIdx}")" class="pf-color-img-add">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <line x1="12" y1="5" x2="12" y2="19" />
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                </svg>
                                <span>Add</span>
                            </label>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="pf-colors-empty">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="16" />
                        <line x1="8" y1="12" x2="16" y2="12" />
                    </svg>
                    <span>No color variants added yet. Click below to add colors and upload images for each.</span>
                </div>
            }

            <button type="button" class="pf-add-color-btn" @onclick="AddColorGroup">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Add Color Variant
            </button>

            @if (ImageError is not null)
            {
                <div class="pf-field-error" style="margin-top:8px">@ImageError</div>
            }
            <div class="pf-gallery-hint">Max @(MaxImages) total images across all colors, @(MaxFileSizeBytes / (1024 * 1024)) MB each.</div>
        </div>
    </div>

    @if (SaveError is not null)
    {
        <div class="pf-save-error">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            @SaveError
        </div>
    }

    <div class="pf-actions">
        <button class="pf-btn-cancel" @onclick="Cancel" disabled="@Saving">Cancel</button>
        <button class="pf-btn-save" @onclick="Save" disabled="@Saving">
            @if (Saving)
            {
                <span class="pf-spinner"></span>
            }
            @(Saving ? "Saving..." : IsEdit ? "Save Changes" : "Add Product")
        </button>
    </div>

</div>

@code {
    [Parameter] public Product? Existing { get; set; }

    private bool IsEdit => Existing is not null;
    private ProductModel Model = new();
    private List<Style> Styles = new();

    private string? ImageError;
    private string? SaveError;
    private bool ShowValidation;
    private bool Saving;

    private const int MaxImages = 20;
    private const long MaxFileSizeBytes = 4 * 1024 * 1024;

    private static readonly string[] SizeOptions = { "35", "36", "37", "38", "39", "40", "41" };

    private static readonly string[] ColourOptions =
    {
        "Black", "White", "Beige", "Peach", "Tan", "Mint Green", "Cherry Red", "Cream", "Lavender"
    };

    private List<ColorImageGroup> ColorGroups = new();

    private class ColorImageGroup
    {
        public string ColorName { get; set; } = "";
    }

    private string StyleIdStr
    {
        get => Model.StyleId?.ToString() ?? "";
        set
        {
            if (int.TryParse(value, out var id))
                Model.StyleId = id;
            else
                Model.StyleId = null;
        }
    }

    private static List<string> CsvValues(string? csv) =>
        string.IsNullOrWhiteSpace(csv)
            ? new List<string>()
            : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(v => v.Trim()).ToList();

    private bool IsSizeChecked(string size) =>
        CsvValues(Model.Size).Contains(size, StringComparer.OrdinalIgnoreCase);

    private bool IsColourChecked(string colour) =>
        CsvValues(Model.Color).Contains(colour, StringComparer.OrdinalIgnoreCase);

    private void ToggleSize(string size)
    {
        var values = CsvValues(Model.Size);
        if (values.Contains(size, StringComparer.OrdinalIgnoreCase))
            values.RemoveAll(v => v.Equals(size, StringComparison.OrdinalIgnoreCase));
        else
            values.Add(size);
        Model.Size = string.Join(",", values);
    }

    private void ToggleColour(string colour)
    {
        var values = CsvValues(Model.Color);
        if (values.Contains(colour, StringComparer.OrdinalIgnoreCase))
            values.RemoveAll(v => v.Equals(colour, StringComparison.OrdinalIgnoreCase));
        else
            values.Add(colour);
        Model.Color = string.Join(",", values);
    }

    protected override async Task OnInitializedAsync()
    {
        Styles = await StyleService.GetAllAsync();

        if (Existing is not null)
        {
            Model = new ProductModel
            {
                Id = Existing.Id,
                Name = Existing.Name,
                Description = Existing.Description,
                Price = Existing.Price,
                OfferPrice = Existing.OfferPrice,
                Size = Existing.Size,
                Color = Existing.Color,
                Brand = Existing.Brand,
                Category = Existing.Category,
                StyleId = Existing.StyleId,
                StockQuantity = Existing.StockQuantity,
                IsNewArrival = Existing.IsNewArrival,
                IsSpecialOffer = Existing.IsSpecialOffer,
                IsSoldOut = Existing.IsSoldOut,
                CreatedAt = Existing.CreatedAt,
                ProductImages = new()
            };

            var existing = await ProductService.GetByIdAsync(Existing.Id);
            Model.ProductImages = existing ?? new();

            var colorNames = Model.ProductImages
                .Where(x => !string.IsNullOrWhiteSpace(x.Color))
                .Select(x => x.Color!)
                .Distinct()
                .ToList();

            foreach (var c in colorNames)
            {
                ColorGroups.Add(new ColorImageGroup { ColorName = c });
            }
        }
    }

    private List<ECommerce.ViewModel.ProductImages> GetCoverImages()
    {
        return Model.ProductImages
            .Where(x => string.IsNullOrWhiteSpace(x.Color))
            .ToList();
    }

    private List<ECommerce.ViewModel.ProductImages> GetImagesForColor(string colorName)
    {
        return Model.ProductImages
            .Where(x => string.Equals(x.Color, colorName, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private string GetPreviewSrc(ECommerce.ViewModel.ProductImages img)
    {
        return img.ImagePath;
    }

    private void RemoveCoverImage()
    {
        var coverImages = GetCoverImages();
        if (!coverImages.Any()) return;

        var imgToRemove = coverImages.First();
        var idx = Model.ProductImages.IndexOf(imgToRemove);
        if (idx >= 0)
            Model.ProductImages.RemoveAt(idx);
    }

    private void RemoveColorImage(string colorName, int filteredIndex)
    {
        var colorImages = GetImagesForColor(colorName);
        if (filteredIndex < 0 || filteredIndex >= colorImages.Count) return;

        var imgToRemove = colorImages[filteredIndex];
        var idx = Model.ProductImages.IndexOf(imgToRemove);
        if (idx >= 0)
            Model.ProductImages.RemoveAt(idx);
    }

    private void AddColorGroup()
    {
        ColorGroups.Add(new ColorImageGroup { ColorName = "" });
    }

    private void RemoveColorGroup(int groupIndex)
    {
        if (groupIndex < 0 || groupIndex >= ColorGroups.Count) return;

        var colorName = ColorGroups[groupIndex].ColorName;
        Model.ProductImages.RemoveAll(x =>
            string.Equals(x.Color, colorName, StringComparison.OrdinalIgnoreCase));
        ColorGroups.RemoveAt(groupIndex);
    }

    private void OnColorNameChanged(int groupIndex, ChangeEventArgs e)
    {
        if (groupIndex < 0 || groupIndex >= ColorGroups.Count) return;

        var oldName = ColorGroups[groupIndex].ColorName;
        var newName = e.Value?.ToString()?.Trim() ?? "";

        ColorGroups[groupIndex].ColorName = newName;

        foreach (var img in Model.ProductImages)
        {
            if (string.Equals(img.Color, oldName, StringComparison.OrdinalIgnoreCase))
            {
                img.Color = newName;
            }
        }
    }

    private async Task OnCoverSelected(InputFileChangeEventArgs e)
    {
        ImageError = null;
        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxFileSizeBytes)
        {
            ImageError = $"Cover image is larger than {MaxFileSizeBytes / (1024 * 1024)} MB.";
            return;
        }

        var existingCover = GetCoverImages();
        if (existingCover.Any())
        {
            var imgToRemove = existingCover.First();
            var idx = Model.ProductImages.IndexOf(imgToRemove);
            if (idx >= 0) Model.ProductImages.RemoveAt(idx);
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var extension = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(extension)) extension = "jpg";

            Model.ProductImages.Insert(0, new ECommerce.ViewModel.ProductImages
            {
                Id = 0,
                ImagePath = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}",
                Extension = extension,
                Color = null
            });
        }
        catch (Exception)
        {
            ImageError = "Could not read the cover image. Try a different file.";
        }
    }

    private async Task OnColorFilesSelected(int groupIndex, InputFileChangeEventArgs e)
    {
        ImageError = null;

        if (groupIndex < 0 || groupIndex >= ColorGroups.Count) return;

        var colorName = ColorGroups[groupIndex].ColorName;
        if (string.IsNullOrWhiteSpace(colorName))
        {
            ImageError = "Please enter a color name before uploading images.";
            return;
        }

        var totalCount = Model.ProductImages.Count;
        var remainingSlots = MaxImages - totalCount;
        if (remainingSlots <= 0)
        {
            ImageError = $"Maximum {MaxImages} images reached.";
            return;
        }

        var files = e.GetMultipleFiles(MaxImages).Take(remainingSlots).ToList();
        if (e.FileCount > remainingSlots)
        {
            ImageError = $"Only {remainingSlots} more image(s) can be added. The rest were skipped.";
        }

        foreach (var file in files)
        {
            if (file.Size > MaxFileSizeBytes)
            {
                ImageError = $"\"{file.Name}\" is larger than {MaxFileSizeBytes / (1024 * 1024)} MB and was skipped.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(MaxFileSizeBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var extension = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
                if (string.IsNullOrWhiteSpace(extension)) extension = "jpg";

                Model.ProductImages.Add(new ECommerce.ViewModel.ProductImages
                {
                    Id = 0,
                    ImagePath = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}",
                    Extension = extension,
                    Color = colorName
                });
            }
            catch (Exception)
            {
                ImageError = $"Could not read \"{file.Name}\". Try a different image.";
            }
        }
    }

    private bool IsValid() =>
        !string.IsNullOrWhiteSpace(Model.Name) &&
        Model.Price > 0 &&
        Model.StockQuantity >= 0 &&
        Model.ProductImages.Any();

    private async Task Save()
    {
        ShowValidation = true;
        SaveError = null;

        if (!IsValid())
        {
            SaveError = string.IsNullOrWhiteSpace(Model.Name) || Model.Price <= 0
                ? "Please fill in the required fields."
                : "Please add at least one product image.";
            return;
        }

        var first = Model.ProductImages.FirstOrDefault();
        if (first is not null && first.Id == 0)
        {
            Model.ImagePath = first.ImagePath;
            Model.Extension = first.Extension;
        }

        Saving = true;
        try
        {
            if (IsEdit)
            {
                var ok = await ProductService.UpdateAsync(Model);
                if (!ok)
                {
                    SaveError = "Update failed. The product may have been removed.";
                    return;
                }
            }
            else
            {
                await ProductService.AddAsync(Model);
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            SaveError = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            Saving = false;
        }
    }

    private void Cancel() => DialogService.Close(false);

    private static string ColorToHex(string color)
    {
        return (color ?? "").Trim().ToLowerInvariant() switch
        {
            "blue" => "#28548A",
            "navy" => "#082B4C",
            "tan" => "#C8A165",
            "olive" => "#5C6B3F",
