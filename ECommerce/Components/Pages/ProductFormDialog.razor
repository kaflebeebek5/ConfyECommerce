@using ECommerce.Entities
@using ECommerce.ViewModel
@using ECommerce.Services
@inject IProductService ProductService
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="pf-form">

  

    <div class="pf-fields">
        <div class="pf-field">
            <label>Name <span class="pf-required">*</span></label>
            <input class="@("pf-input" + (ShowValidation && string.IsNullOrWhiteSpace(Model.Name) ? " pf-input-error" : ""))"
                   @bind="Model.Name" @bind:event="oninput" placeholder="e.g. Classic Leather Sandal" />
        </div>

        <div class="pf-field">
            <label>Description</label>
            <textarea class="pf-input pf-textarea" @bind="Model.Description" rows="3"
                      placeholder="Short product description"></textarea>
        </div>

        <div class="pf-row">
            <div class="pf-field">
                <label>Brand</label>
                <input class="pf-input" @bind="Model.Brand" placeholder="e.g. Klobyte" />
            </div>
            <div class="pf-field">
                <label>Price (Rs.) <span class="pf-required">*</span></label>
                <input type="number" min="0" step="1"
                       class="@("pf-input" + (ShowValidation && Model.Price <= 0 ? " pf-input-error" : ""))"
                       @bind="Model.Price" />
            </div>
        </div>

        <div class="pf-row">
            <div class="pf-field">
                <label>Size <span class="pf-hint">(CSV or range, e.g. "38-45")</span></label>
                <input class="pf-input" @bind="Model.Size" placeholder="38,39,40,41" />
            </div>
            <div class="pf-field">
                <label>Color</label>
                <input class="pf-input" @bind="Model.Color" placeholder="e.g. Tan" />
            </div>
        </div>

        <div class="pf-field">
            <label>Stock Quantity <span class="pf-required">*</span></label>
            <input type="number" min="0" step="1"
                   class="@("pf-input" + (ShowValidation && Model.StockQuantity < 0 ? " pf-input-error" : ""))"
                   @bind="Model.StockQuantity" />
        </div>
        <div class="pf-gallery-section">
            <label class="pf-gallery-label">Product Images <span class="pf-required">*</span></label>

            <div class="pf-gallery-grid">
                @* Single unified list — existing (Id != 0) and newly-picked (Id == 0) images together *@
                @for (int i = 0; i < Model.ProductImages.Count; i++)
                {
                    var index = i;
                    var img = Model.ProductImages[index];
                    var isExisting = img.Id != 0;

                    <div class="@("pf-gallery-item" + (isExisting ? " pf-gallery-item-existing" : ""))">
                        <img src="@GetPreviewSrc(img)" alt="Product image" />
                        <button type="button" class="pf-gallery-remove" @onclick="@(() => RemoveImage(index))">×</button>
                        @if (isExisting)
                        {
                            <span class="pf-gallery-existing-tag">Saved</span>
                        }
                        else if (index == 0)
                        {
                            <span class="pf-gallery-cover-tag">Cover</span>
                        }
                    </div>
                }

                <InputFile OnChange="OnFilesSelected" multiple accept="image/*" class="pf-file-input" id="pf-file-input" style="display:none" />
                <label for="pf-file-input" class="pf-gallery-add">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    <span>Add Images</span>
                </label>
            </div>

            @if (ImageError is not null)
            {
                <div class="pf-field-error">@ImageError</div>
            }
            <div class="pf-gallery-hint">First image is used as the cover photo. Up to @MaxImages images, @(MaxFileSizeBytes / (1024 * 1024)) MB each.</div>
        </div>
    </div>

    @if (SaveError is not null)
    {
        <div class="pf-field-error pf-save-error">@SaveError</div>
    }

    <div class="pf-actions">
        <button class="pf-btn-cancel" @onclick="Cancel" disabled="@Saving">Cancel</button>
        <button class="pf-btn-save" @onclick="Save" disabled="@Saving">
            @(Saving ? "Saving…" : IsEdit ? "Save Changes" : "Add Product")
        </button>
    </div>

</div>

@code {
    [Parameter] public Product? Existing { get; set; }

    private bool IsEdit => Existing is not null;
    private ProductModel Model = new();

    // Only the Ids that were present when the dialog first loaded — used purely to
    // work out what got removed (OriginalImageIds minus whatever Ids remain in
    // Model.ProductImages when Save is clicked). Not a second copy of the images.
    private List<int> OriginalImageIds = new();

    private string? ImageError;
    private string? SaveError;
    private bool ShowValidation;
    private bool Saving;

    private const int MaxImages = 8;
    private const long MaxFileSizeBytes = 4 * 1024 * 1024; // 4 MB per image

    protected override async Task OnInitializedAsync()
    {
        if (Existing is not null)
        {
            Model = new ProductModel
            {
                Id = Existing.Id,
                Name = Existing.Name,
                Description = Existing.Description,
                Price = Existing.Price,
                Size = Existing.Size,
                Color = Existing.Color,
                Brand = Existing.Brand,
                StockQuantity = Existing.StockQuantity,
                CreatedAt = Existing.CreatedAt,
                ProductImages = new()
            };

            var existing = await ProductService.GetByIdAsync(Existing.Id);
            Model.ProductImages = existing ?? new();
            // OriginalImageIds = Model.ProductImages.Select(i => i.Id).ToList();
        }
    }

    // Existing images (Id != 0) already have a real URL in ImagePath — shown as-is.
    // New images (Id == 0) hold raw Base64 with no data: prefix (that's what gets
    // sent to the backend), so the prefix is added here purely for display.
    private string GetPreviewSrc(ECommerce.ViewModel.ProductImages img)
    {
       return img.ImagePath;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        ImageError = null;

        var remainingSlots = MaxImages - Model.ProductImages.Count;
        if (remainingSlots <= 0)
        {
            ImageError = $"You can only have up to {MaxImages} images.";
            return;
        }

        var files = e.GetMultipleFiles(MaxImages).Take(remainingSlots).ToList();
        if (e.FileCount > remainingSlots)
        {
            ImageError = $"Only {remainingSlots} more image(s) can be added (max {MaxImages} total). The rest were skipped.";
        }

        foreach (var file in files)
        {
            if (file.Size > MaxFileSizeBytes)
            {
                ImageError = $"\"{file.Name}\" is larger than {MaxFileSizeBytes / (1024 * 1024)} MB and was skipped.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(MaxFileSizeBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                var extension = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
                if (string.IsNullOrWhiteSpace(extension)) extension = "jpg";

                // Id stays 0 (default) — that's how new images are told apart from existing ones,
                // both here and on the backend. ImagePath is raw Base64, no data: prefix.
                Model.ProductImages.Add(new ECommerce.ViewModel.ProductImages
                {
                    Id = 0,
                    ImagePath =  $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}",
                    Extension = extension
                });
            }
            catch (Exception)
            {
                ImageError = $"Could not read \"{file.Name}\". Try a different image.";
            }
        }
    }

    private void RemoveImage(int index)
    {
        Model.ProductImages.RemoveAt(index);
    }

    private bool IsValid() =>
        !string.IsNullOrWhiteSpace(Model.Name) &&
        Model.Price > 0 &&
        Model.StockQuantity >= 0 &&
        Model.ProductImages.Any();

    private async Task Save()
    {
        ShowValidation = true;
        SaveError = null;

        if (!IsValid())
        {
            SaveError = string.IsNullOrWhiteSpace(Model.Name) || Model.Price <= 0
                ? "Please fill in the required fields."
                : "Please add at least one product image.";
            return;
        }

        // Anything that was in the original list but isn't in Model.ProductImages
        // anymore was removed by the user this session.
        var remainingExistingIds = Model.ProductImages.Where(i => i.Id != 0).Select(i => i.Id);
        // Model.RemovedImageIds = OriginalImageIds.Except(remainingExistingIds).ToList();

        // Cover image: only overwritten if the first image in the list is a NEW one.
        // If the first image is an existing (Id != 0) one, the backend already has the
        // right cover and ImagePath/Extension are left empty so nothing gets re-uploaded.
        var first = Model.ProductImages.FirstOrDefault();
        if (first is not null && first.Id == 0)
        {
            Model.ImagePath = first.ImagePath;
            Model.Extension = first.Extension;
        }

        Saving = true;
        try
        {
            if (IsEdit)
            {
                var ok = await ProductService.UpdateAsync(Model);
                if (!ok)
                {
                    SaveError = "Update failed. The product may have been removed.";
                    return;
                }
            }
            else
            {
                await ProductService.AddAsync(Model);
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            SaveError = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            Saving = false;
        }
    }

    private void Cancel() => DialogService.Close(false);
}
